{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch maestro gdb",
            "type": "cppdbg",
            "request": "launch",
            "miDebuggerPath": "/usr/local/bin/elmo-${command:elmo.getMaestroType}-gdb",
            "miDebuggerArgs": "--cd=${workspaceFolder}",
            "MIMode": "gdb",
            "program": "${command:elmo.getLaunchTargetPath}",
            "args": [],
            "stopAtEntry": true,
            "setupCommands": [
                {
                    "text": "set remotetimeout 5"
                },
                {
                    "text": "target extended-remote ${command:elmo.getTargetIP}:3333"
                },
                {
                    "text": "set remote exec-file /mnt/jffs/usr/${workspaceFolderBasename}"
                },
                {
                    "text": "file '${command:elmo.getLaunchTargetPath}'"
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
            ],
            "launchCompleteCommand": "exec-run",
            "externalConsole": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "preLaunchTask": "start gdbserver",
        }
    ]
}